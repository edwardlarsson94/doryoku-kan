# ==========================================
# Archivos que Git NO subirá a GitHub
# ==========================================

# 📦 Dependencias y compilación
/node_modules
/dist
/tmp
/out-tsc
/bazel-out

# 📦 Registro de paquetes
npm-debug.log
yarn-error.log

# ⚡ Caché de Angular
/.angular/cache
.sass-cache/

# 💻 Archivos de sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# 📝 Archivos del editor — VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/*

# 📝 Otros editores
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.swp

# 🧪 Archivos temporales y pruebas
*.log
*.tmp
*.temp
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/